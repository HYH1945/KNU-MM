# ============================================================
# KNU-MM 통합 멀티모달 관제 시스템 - 환경 변수 예시
# ============================================================
# 이 파일을 복사하여 .env로 만들고 값을 채워 넣으세요:
#   cp .env.example .env
#
# .env 파일은 git에 추적되지 않습니다.

# ─── 카메라 ───
RTSP_URL=                    # 예: rtsp://user:pass@***REMOVED_IP***:554/Streaming/Channels/101
CAMERA_IP=                   # 예: ***REMOVED_IP***
CAMERA_PORT=80
CAMERA_USER=
CAMERA_PASSWORD=

# ─── OpenAI ───
OPENAI_API_KEY=              # 예: sk-proj-...
