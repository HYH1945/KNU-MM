# -----------------------------------------------------------
# KNU-MM runtime environment sample
# Copy to: .env
# -----------------------------------------------------------

# OpenAI
OPENAI_API_KEY=

# Camera connection (used by integrated_system / integrated_system_process)
# Preferred: CAMERA_RTSP_URL (legacy fallback: RTSP_URL)
CAMERA_RTSP_URL=
RTSP_URL=

# Optional: local test video path
CAMERA_TEST_VIDEO=
TEST_VIDEO=

# PTZ camera credentials
CAMERA_IP=
CAMERA_PORT=80
CAMERA_USER=
CAMERA_PASSWORD=
