# ContextLLM 설정 파일 예제
# 이 파일을 config.yaml로 복사하고 실제 값을 입력하세요.
# config.yaml은 .gitignore에 등록되어 있으므로 리포지토리에 커밋되지 않습니다.

# API 키 설정 (방법 중 하나를 선택)
# 1) config/config.yaml의 api_keys.openai
# 2) config/.env 의 OPENAI_API_KEY
# 3) 셸 환경변수 OPENAI_API_KEY

# 권장: 방법 2 또는 3 (환경변수 사용 권장)
api_keys:
  openai: ""  # 또는 여기에 입력: sk-...

# 모델 설정
mode: realtime  # realtime | testset | file | webcam | network
model: gpt-4o-mini  # gpt-4o-mini 또는 gpt-4o

# 영상 설정
video:
  camera_id: 0                  # 웹캠 ID (0: 기본 카메라)
  testset_path: "testsets"      # 테스트셋 폴더 경로
  network_url: ""               # 네트워크 카메라 URL (mode=network)
  file_path: ""                 # 분석 파일 경로 (mode=file)
  resolution:
    width: 1280
    height: 720

# 분석 설정
analysis:
  default_text: ""              # 음성 대신 사용할 기본 텍스트
  iterations: null              # null: 무한 반복, 숫자: N회 반복
  analyze_all_testset: false    # testset 모드에서 전체 파일 분석
  llm_frame_count: 4            # LLM에 전달할 최대 프레임 수
  prebuffer_seconds: 1.5        # 실시간 프레임 프리버퍼(초). null이면 자동 계산
  postbuffer_seconds: 0.5       # 실시간 프레임 포스트버퍼(초). null이면 자동 계산
  buffer_window_seconds: 8.0    # 버퍼 보관 길이(초). 프리/포스트보다 작으면 자동 보정
  parallel: false               # 호환 옵션 (현재는 순차 모니터링과 동일)
  voice_characteristics: false  # 음성 특성 분석 활성화
  streaming: false              # OpenAI 응답 스트리밍
  testset_index: 0              # 테스트셋 기본 인덱스

# config 기반 멀티 입력 테스트 ("" = 미입력)
# mode: testset + media_test.enabled: true
# video_path만 넣으면 비디오 오디오를 자동 추출해 YAMNet/STT 분석에 사용
media_test:
  enabled: false
  image_path: ""                # 이미지 파일 경로
  video_path: ""                # 비디오 파일 경로(mp4 등)
  audio_path: ""                # 오디오 파일 경로(mp3/wav 등, 설정 시 video 오디오보다 우선)
  text_input: ""                # 오디오 파일 보조 텍스트(선택)
  phrase_time_limit: 6.0        # audio_path가 없을 때 실시간 음성 최대 길이

# 다운샘플링 설정
downsampling:
  max_image_size: 480           # 최대 이미지 크기 (픽셀, 낮출수록 빠름)
  jpeg_quality: 75              # JPEG 품질 (1-100)
  video_fps: 2.0                # 분석용 FPS
  max_video_frames: 10          # 최대 분석 프레임 수
  video_capture_duration: 5.0   # 비디오 캡처 길이 (초)

# 표시 설정
display:
  web_enabled: false            # 웹 대시보드 활성화
  web_port: 5000                # 웹 대시보드 포트 (localhost만)
  opencv_live: true             # OpenCV 라이브 디스플레이 (라이브 모드만)
  keep_open_after_run: false    # 배치 분석 종료 후 웹 대시보드 유지

# 로깅 설정
logging:
  verbose: false                # 상세 로그 출력
  save_logs: true               # 로그 파일 저장
  log_dir: "data/logs"

# 음성 인식 설정
speech:
  enabled: true                 # true: 음성 트리거 사용, false: 음성 비활성
  language: "ko-KR"             # 기본 STT 언어
  recognition_languages:        # 파일/비디오 STT 언어 후보 (순서대로 시도)
    - "ko-KR"
    - "en-US"
  energy_threshold: 400         # 음성 감지 민감도 (낮을수록 민감)
  pause_threshold: 0.8          # 문장 끝 판단 무음 시간(초)
  dynamic_threshold: false      # 동적 임계값 사용 여부

# 음성 특성 분석 임계값
voice_analysis:
  pitch:
    high_threshold: 250
    variability_threshold: 50
  energy:
    high_threshold: 0.05
  speech_rate:
    fast_threshold: 7

# 비음성 사운드 이벤트 감지 (YAMNet)
sound_event:
  enabled: true
  model_url: "https://tfhub.dev/google/yamnet/1"
  min_confidence: 0.12
  trigger_threshold: 0.18
  top_k: 5
  emergency_keywords:
    - scream
    - shout
    - yell
    - glass
    - breaking
    - gunshot
    - explosion
    - siren
    - alarm

# OpenAI API 설정
openai:
  max_tokens: 800               # 최대 응답 토큰
  temperature: 0.3              # 창의성 (0-1, 낮을수록 일관성 있음)
  image_detail: "low"           # low, high (저해상도는 빠르고 저렴)
  timeout: 30                   # API 타임아웃 (초)
